{
  "expo": {
    "name": "Cross-Duel",
    "slug": "cross-duel",
    "scheme": "crossduel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.crossduel.app" },
    "android": { "package": "com.crossduel.app", "adaptiveIcon": { "backgroundColor": "#FFFFFF" } },
    "plugins": ["expo-router", "expo-font"],
    "experiments": { "typedRoutes": true }
  }
}
