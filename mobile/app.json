{
  "expo": {
    "name": "CrossDuel",
    "slug": "crossduel",
    "scheme": "crossduel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crossduel.app"
    },
    "android": {
      "package": "com.crossduel.app"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
